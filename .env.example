# 玄铁栈道 EquiLedger · 环境变量模板：cp .env.example .env 后填写；.env 已被 .gitignore 排除
# 强口令生成：openssl rand -hex 24
EQUI_OWNER_PWD=
EQUI_APP_PWD=
# 群机器人推送（企业微信/钉钉/飞书 webhook），可空
EQUI_WEBHOOK_URL=
# WooCommerce webhook 签名密钥，可空
EQUI_WOO_SECRET=
# 月底自动算薪：1=开（默认），0=关；EQUI_PAYROLL_DAY 空=每月最后一天，填 25=每月 25 号
EQUI_PAYROLL_AUTO=1
EQUI_PAYROLL_DAY=
# 自动加密备份（--profile backup 启用）：口令必填、目录建议异机/NAS
EQUI_BACKUP_PASSPHRASE=
EQUI_BACKUP_DIR=./backups
EQUI_BACKUP_INTERVAL_MIN=1440
EQUI_BACKUP_KEEP=30